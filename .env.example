# ========================================================
# DoraMate Agent 环境变量
# ========================================================
# 把这个文件复制为 .env 后填入真实的 API Key。
# .env 文件已经在 .gitignore 里，不会被提交到 GitHub。
#
# 安全提醒：永远不要把真实 API Key 发到聊天软件、邮件、
# 公开仓库、或贴到任何公开页面（包括给 AI 的对话）。
# ========================================================

# --- DeepSeek（推荐：国内直连+便宜，强烈推荐）---
# 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- OpenAI（可选）---
# OPENAI_API_KEY=sk-your-openai-key-here

# --- Anthropic Claude（可选，未来支持）---
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- 阿里云通义千问（可选，未来支持）---
# DASHSCOPE_API_KEY=sk-your-dashscope-key-here

# ========================================================
# 平台 Token（用于自动发布，可选）
# ========================================================
# 微信公众号
# WECHAT_APPID=
# WECHAT_APPSECRET=

# B站（如果将来加自动上传）
# BILIBILI_SESSDATA=

# CSDN（如果将来加自动发布）
# CSDN_COOKIE=
